{
    "name": "@tygo-van-den-hurk/type-sea",
    "license": "MIT",
    "description": "TypeScript helper types, and the improved enums a la Rust style.",
    "homepage": "https://Tygo-van-den-Hurk.github.io/Type-Sea",
    "author": "Tygo van den Hurk",
    "version": "0.0.0",
    "private": false,
    "keywords": [
        "typescript",
        "ts",
        "typescript-enums",
        "enums",
        "types",
        "safe",
        "rust"
    ],
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/Tygo-van-den-Hurk"
        }
    ],
    "support": {
        "backing": {
            "npm-funding": true
        }
    },
    "repository": {
        "type": "git",
        "url": "git://github.com/Tygo-van-den-Hurk/Type-Sea.git"
    },
    "bugs": {
        "url": "https://github.com/Tygo-van-den-Hurk/Type-Sea/issues"
    },
    "maintainers": [
        "Tygo van den Hurk"
    ],
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "imports": {
        "#package": "./package.json",
        "#src/*": {
            "types": "./dist/mjs/*.d.ts",
            "require": "./dist/cjs/*.js",
            "import": "./dist/mjs/*.js"
        }
    },
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/mjs/index.d.cts",
            "require": "./dist/cjs/index.js",
            "import": "./dist/mjs/index.js"
        }
    },
    "scripts": {
        "build": "npm --silent run build:cjs && npm --silent run build:mjs",
        "build:cjs": "tsc --project tsconfig.cjs.json",
        "postbuild:cjs": "rimraf dist/package.json",
        "build:mjs": "tsc --project tsconfig.mjs.json",
        "postbuild:mjs": "rimraf dist/package.json",
        "test": "vitest --dir test run --silent passed-only",
        "test:watch": "vitest --dir test watch --cache --silent passed-only",
        "test:coverage": "vitest --dir test run --coverage --silent passed-only",
        "coverage": "npm run --silent test:coverage --",
        "lint": "npm run --silent lint:check --",
        "lint:check": "eslint '{src,test}/**/*.{js,ts}' --cache --cache-location ./.cache/eslint/",
        "lint:write": "eslint '{src,test}/**/*.{js,ts}' --cache --cache-location ./.cache/eslint/ --fix",
        "lint:fix": "npm run --silent lint:write --",
        "format": "npm run --silent format:write --",
        "format:check": "prettier '{src,test}/**/*.{js,ts}' --check",
        "format:write": "prettier '{src,test}/**/*.{js,ts}' --write",
        "format:fix": "npm run --silent format:write --"
    },
    "dependencies": {},
    "devDependencies": {
        "@types/node": "^24.5.2",
        "@vitest/coverage-istanbul": "^3.2.4",
        "eslint": "^9.37.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsdoc": "^61.1.10",
        "eslint-plugin-prettier": "^5.1.3",
        "prettier": "^3.6.2",
        "rimraf": "^6.1.0",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.46.2",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^3.2.4"
    }
}
